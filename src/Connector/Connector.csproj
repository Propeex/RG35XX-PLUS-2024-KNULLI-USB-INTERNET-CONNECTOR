<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RG35XXUsbInternetConnector</AssemblyName>
    <RootNamespace>RG35XXUsbInternetConnector</RootNamespace>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta.0</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The EXE is copied for the safe self-update helper. Bundle native runtime files too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated by GitHub Actions from tracked Go/shell/PowerShell sources
         and an upstream hash-pinned MIT-licensed tun2socks release. -->
    <EmbeddedResource Include="assets/backend.zip"
                      LogicalName="RG35XXUsbInternetConnector.EmbeddedBackend"
                      Condition="Exists('assets/backend.zip')" />
  </ItemGroup>
</Project>
