<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RG35XXUsbInternetConnector</AssemblyName>
    <Product>KNULLI USB Link</Product>
    <ApplicationIcon>..\..\assets\knulli-usb-link.ico</ApplicationIcon>
    <RootNamespace>RG35XXUsbInternetConnector</RootNamespace>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta.1</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Windows 10/11 start through a tiny .NET Framework 4.x launcher.
         Only the missing .NET 8 Desktop Runtime is installed once per user. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
